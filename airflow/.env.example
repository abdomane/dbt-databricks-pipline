# Copy this file to `airflow/.env` and fill in your Databricks values.
# `airflow/.env` is git-ignored so secrets never get committed.

AIRFLOW_UID=50000

# Shared by Airflow components to sign execution API tokens. Replace with a random value.
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-random-secret

# Airflow 3 SimpleAuthManager username (the password is generated at startup)
_AIRFLOW_WWW_USER_USERNAME=admin

# Databricks Connection (automatically creates `databricks_default` in Airflow)
# Format: databricks://token:<PERSONAL_ACCESS_TOKEN>@<WORKSPACE_HOST>?http_path=<SQL_WAREHOUSE_HTTP_PATH>
AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://token:dapi_YOUR_TOKEN@dbc-xxxxxxxx-xxxx.cloud.databricks.com?http_path=/sql/1.0/warehouses/YOUR_WAREHOUSE_ID

# Catalog where Airflow will build dbt models (`dev` for testing, `prod` for production)
DBT_TARGET_CATALOG=dev

# Optional: Existing Databricks Job ID for the `load_raw` ingestion task.
# If left empty or 0, the `load_raw_job_postings` task will be skipped unless triggered against a real Job ID.
AIRFLOW_VAR_DATABRICKS_LOAD_RAW_JOB_ID=0
